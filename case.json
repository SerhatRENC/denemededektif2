  "day2_dialogs": {
    "muhtar_halit": [
      { "speaker": "Halit", "text": "Dedektif hoş geldin, dün merkezde işlerim vardı kusura bakma. Bugün ne istiyorsan konuşalım." },
      { "speaker": "Dedektif", "text": "Önemli değil. Otopsi raporu sizdeymiş Kamuran Hanım söyledi. Bir de dün hancı odaya girmeme izin vermedi orayı incelemem lazım." },
      { "speaker": "Halit", "text": "He tamam siz gidin Rıza'ya benden selam söyleyin açar kapıyı. Odadaki eşyalara kimse dokunmasın diye kilitli kalsın demiştim. Otopsi raporunun da kopyasını yollatırım senin ofisine." }
    ],
    "hanci_riza": [
      { "speaker": "Rıza", "text": "Beyim bakırcılar geldiler, onlar arada bir gelirler böyle işler çok yoğun olur bugünlerde yarın detaylıca konuşalım istersen şimdi doluyum." },
      { "speaker": "Dedektif", "text": "Tamam Rıza Bey. Yalnız benim odayı görmem lazım Halit Bey selamını iletti." },
      { "speaker": "Rıza", "text": "Tabii buyrun odanın anahtarı." }
    ],
    "bakirci1": [
      { "speaker": "Bakırcı Ahmet", "text": "Cinayet ha? Çetrefilli işler bunlar... Allah kolaylık versin." },
      { "speaker": "Dedektif", "text": "Sağ olun. Sizler sık gelir misiniz buraya?" },
      { "speaker": "Bakırcı Ahmet", "text": "Beyim biz zaten bu köyden değiliz. Bakırcıyız biz kimi ticaret yaparız kimi hoş sohbete geliriz sadece. Bir şey bilmeyiz yani." }
    ],
    "bakirci2": [
      { "speaker": "Dedektif", "text": "Afiyet olsun." },
      { "speaker": "Bakırcı Hüseyin", "text": "Buyrun beraber olsun." },
      { "speaker": "Dedektif", "text": "Sağ olun. Hangi köydensiniz?" },
      { "speaker": "Bakırcı Hüseyin", "text": "Bakırcılar efendim. İş için dolaşınca uğrayıp bir iki kadeh yuvarlayalım dedik. Biraz dinlenip köyümüze gideceğiz." },
      { "speaker": "Dedektif", "text": "Geldiğiniz zamanlarda gazeteciye hiç rastladınız mı?" },
      { "speaker": "Bakırcı Hüseyin", "text": "Sima olarak gördük ama hiç sohbetimiz olmadı." },
      { "speaker": "Dedektif", "text": "Anladım." }
    ]
  },

