  "characters": {
    "muhtar": {
      "name": "Muhtar Halit",
      "image": "assets/karakterler/halit.webp",
      "clickableImage": "assets/tiklanabilir/muhtar_tiklanabilir.webp",
      "clickableArea": { "x": "50.9%", "y": "29.9%", "w": "29.0%", "h": "61.6%" },
      "yOffset": "-15%",
      "dialog": [
        { "speaker": "Halit", "text": "Buyrun dedektif bey. Çıkacağım birazdan, acil bir şey var mı?" },
        { "speaker": "Dedektif", "text": "Sizinle Ali İhsan bey hakkında konuşmam lazım." },
        { "speaker": "Halit", "text": "Ben de onun ölüm belgelerini merkeze götüreceğim şimdi." },
        { "speaker": "Halit", "text": "Sen en iyisi mi yarın uğra, bana konuşalım — şimdi gitmem gerek." }
      ]
    },
    "han": {
      "name": "Hancı Rıza",
      "image": "assets/karakterler/riza.webp",
      "clickableImage": "assets/tiklanabilir/riza_tiklanabilir.webp",
      "clickableArea": { "x": "60.3%", "y": "39.3%", "w": "18.9%", "h": "56.9%" },
      "yOffset": "-15%",
      "dialog": [
        { "speaker": "Dedektif", "text": "Ali İhsan bey senin hanında ölü bulunmuş." },
        { "speaker": "Rıza", "text": "Evet beyim, çok efendi bir adamdı." },
        { "speaker": "Rıza", "text": "Hatta 25 gündür burada olmasına rağmen bana bile yardım etmişliği vardır." },
        { "speaker": "Rıza", "text": "Valla üzülmedim desem yalan olur." },
        { "speaker": "Dedektif", "text": "Anlaşamadığı birisi var mıydı?" },
        { "speaker": "Rıza", "text": "Valla dediğim gibi efendi bir adamdı, kimseyle ters düştüğünü görmedim..." },
        { "speaker": "Rıza", "text": "Gerçi... Kart Nadire geçen anlatmıştı, bizim muhtarla bir iki takışmışlar." },
        { "speaker": "Rıza", "text": "Kızıyla konuşmasını mı istememiş, ne öyle bir şey varmış." },
        { "speaker": "Dedektif", "text": "Neden istememiş, biliyor musun?" },
        { "speaker": "Rıza", "text": "Valla ben bilmiyorum, Nadire'ye sorun isterseniz." }
      ]
    }
  },

